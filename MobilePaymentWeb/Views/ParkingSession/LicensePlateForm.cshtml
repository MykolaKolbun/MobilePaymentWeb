@{
    ViewData["Title"] = "Пошук паркування";
}

<div class="card">
    <h1>Alternatiview</h1>
    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }
    <form id="lpForm" method="get" asp-action="ParkingSession">
        <div class="section">
            <div class="label">Введіть номер авто:</div>
            <input type="text" name="licensePlate" placeholder="AA0000AA"
                   autocomplete="off" autofocus minlength="3" required />
        </div>
    </form>
</div>

<div class="sticky-pay">
    <button type="submit" form="lpForm" class="pay-btn">Знайти</button>
</div>