@{
    ViewData["Title"] = "Обробка платежу";
}

<div class="card">
    <partial name="_BrandHeader" />
    <h1 id="status-title">Обробка платежу...</h1>
    <div class="section">
        <div class="label" id="status-message">Будь ласка, зачекайте</div>
    </div>
    <div id="receipt-container" style="display:none; margin-top: 15px;">
        <img id="receipt-img" alt="Фіскальний чек" style="width: 100%; border-radius: 8px;" />
        <a id="receipt-download" class="download-btn" download="receipt.png">Зберегти чек</a>
    </div>
</div>

<script>
    const facilityId = '@ViewBag.FacilityId';
    const interval = setInterval(async () => {
        const res = await fetch('/' + facilityId + '/status');
        const data = await res.json();

        if (data.statusCode === 5) {
            clearInterval(interval);
            document.getElementById('status-title').innerText = 'Оплата успішна!';
            document.getElementById('status-message').innerText = 'Дякуємо! Ви можете виїжджати.';
            if (data.hasFiscal) {
                // Load the receipt only now — it doesn't exist at page-load time,
                // and the cache-buster forces the fetch (a hardcoded src would have 404'd on load).
                var receiptUrl = '/' + facilityId + '/receipt-image?t=' + Date.now();
                document.getElementById('receipt-img').src = receiptUrl;
                document.getElementById('receipt-download').href = receiptUrl;
                document.getElementById('receipt-container').style.display = 'block';
            }
        } else if (data.statusCode === 4) {
            clearInterval(interval);
            document.getElementById('status-title').innerText = 'Оплата не вдалась';
            document.getElementById('status-message').innerText = 'Спробуйте ще раз або зверніться на касу.';
        }
    }, 2000);
</script>
