@model MobilePaymentWeb.Models.ParkingSessionViewModel

<div class="card">
    <img src="~/images/alternatiview_logo_big.svg" alt="Alternatiview" style="width: 100%; margin-bottom: 5px;" />
    <div class="section">
    @{
        if (Model.CarLP != null)
        {
        
            <div class="label">Номер авто:</div>
            <div class="value">@Model.CarLP</div>
        }
    }
    @{
        if (Model.EntryTime != null)
        {
        
                <div class="label">В’їзд:</div>
                <div class="value">@Model.EntryTime</div>
        }
    }
    </div>
    <div class="section">
        <div class="label">Час на паркінгу:</div>
        <div class="value">@Model.ParkDuration</div>
    </div>

    <hr />

    <div class="section">
        <div class="label">До сплати:</div>
        <div class="price">@Model.Price грн</div>
        <div style="margin-top: 15px;">
            <partial name="_PayButton" model="Model" />
        </div>
    </div>
    
</div>
